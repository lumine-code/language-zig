{
  "name": "Zig",
  "scopeName": "source.zig",
  "type": "tree-sitter",
  "parser": "tree-sitter-zig",
  "injectionNames": ["zig"],
  "fileTypes": ["zig", "zon"],
  "comments": {
    "start": "/ "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:tree-sitter-grammars/tree-sitter-zig#v1.1.2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "zig.wasm",
    "highlightsQuery": "zig-highlights.scm",
    "foldsQuery": "zig-folds.scm"
  }
}
